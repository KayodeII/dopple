NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# The app role. Must not be a superuser, or row-level security is bypassed.
DATABASE_URL=postgres://dopple_app:dopple_app@localhost:5432/dopple
# The owner role, used only by migrations and the seed script.
MIGRATION_DATABASE_URL=postgres://dopple:dopple@localhost:5432/dopple

# Schools are served at <slug>.<PLATFORM_DOMAIN>. *.localhost resolves to 127.0.0.1.
PLATFORM_DOMAIN=dopple.localhost
TENANT_CACHE_TTL_SECONDS=60

# Auth. Leave JWT_PRIVATE_KEY empty locally: a throwaway key is generated at boot.
# Production needs a real one: openssl genpkey -algorithm ed25519 (newlines as \n).
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Sign-in attempts per client IP per minute.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Schools (ADR 0010). Where a school's web app lives: {host} is <slug>.<PLATFORM_DOMAIN>
# or its custom domain. Production: https://{host}. Locally the web app runs on :3200.
SCHOOL_URL_FORMAT=http://{host}:3200
# New schools per client IP per hour, through self-serve sign-up.
SCHOOL_SIGNUPS_PER_HOUR=5

# Fee payments (ADR 0013). `fake` moves no money. To use Bachs, set PAYMENT_PROVIDER=bachs
# and its keys: an sk_sandbox_ key talks to the sandbox, an sk_live_ key to production.
PAYMENT_PROVIDER=fake
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# OpenTelemetry. The local Grafana stack (pnpm infra:up) listens on 4318.
OTEL_SERVICE_NAME=dopple-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
